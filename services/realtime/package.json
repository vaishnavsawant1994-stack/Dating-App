    "test:integration": "vitest run tests/app.test.ts"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.0",
    "fastify": "5.12.5",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "tsx": "4.23.15"
  }
}

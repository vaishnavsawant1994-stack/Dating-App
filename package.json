{
  "name": "together-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Engineering monorepo for the together dating, social, communities, live, creator economy, trust and safety platform.",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.21.0 <27",
    "pnpm": ">=12.11.2 <13"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "generate": "turbo run generate",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:contracts": "turbo run test:contracts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @together/database db:migrate",
    "db:rollback": "pnpm --filter @together/database db:rollback",
    "db:status": "pnpm --filter @together/database db:status",
    "db:validate": "pnpm --filter @together/database db:validate",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "eslint": "10.10.0",
    "prettier": "3.9.10",
    "turbo": "2.10.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.4"
  }
}

APP_ENV=local
SERVICE_NAME=api
LOG_LEVEL=info

# Local development only. Never commit production credentials.
DATABASE_URL=postgres://together:together@127.0.0.1:5432/together

REDIS_URL=redis://127.0.0.1:6379
EVENT_BUS_URL=local://events
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000

# Consumer web public configuration.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# Internal Admin web public configuration. This must remain a separate API surface.
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://127.0.0.1:3005

# Local/test-only switch used to render the Stage 0 Admin shell preview. Production ignores it.
ADMIN_SHELL_PREVIEW=false

# Mobile public configuration. Secrets must never use EXPO_PUBLIC_* variables.
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_API_BASE_URL=

# Realtime transport. Authentication remains fail-closed until the Auth tranche wires a verifier.
REALTIME_HOST=127.0.0.1
REALTIME_PORT=3002
REALTIME_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
REALTIME_MAX_PAYLOAD_BYTES=32768
REALTIME_MAX_BUFFERED_BYTES=524288
REALTIME_HEARTBEAT_MS=30000
REALTIME_HELLO_TIMEOUT_MS=5000
REALTIME_RATE_WINDOW_MS=10000
REALTIME_MAX_MESSAGES_PER_WINDOW=100

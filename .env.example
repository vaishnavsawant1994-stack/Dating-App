APP_ENV=local
SERVICE_NAME=api
LOG_LEVEL=info

# Local development only. Never commit production credentials.
DATABASE_URL=postgres://together:together@127.0.0.1:5432/together

REDIS_URL=redis://127.0.0.1:6379
EVENT_BUS_URL=local://events
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000

# Consumer web public configuration.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# Internal Admin web public configuration. This must remain a separate API surface.
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://127.0.0.1:3005

# Local/test-only switch used to render the Stage 0 Admin shell preview. Production ignores it.
ADMIN_SHELL_PREVIEW=false

# Mobile public configuration. Secrets must never use EXPO_PUBLIC_* variables.
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_API_BASE_URL=

# Realtime transport. Authentication remains fail-closed until the Auth tranche wires a verifier.
REALTIME_HOST=127.0.0.1
REALTIME_PORT=3002
REALTIME_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
REALTIME_MAX_PAYLOAD_BYTES=32768
REALTIME_MAX_BUFFERED_BYTES=524288
REALTIME_HEARTBEAT_MS=30000
REALTIME_HELLO_TIMEOUT_MS=5000
REALTIME_RATE_WINDOW_MS=10000
REALTIME_MAX_MESSAGES_PER_WINDOW=100

# AI gateway. Fake AI is local/test/sandbox only; production defaults to disabled.
AI_HOST=127.0.0.1
AI_PORT=3003
AI_PROVIDER=fake
AI_MAX_INPUT_CHARS=100000
AI_MAX_OUTPUT_TOKENS=4096
AI_BODY_LIMIT_BYTES=262144

# Media service. Credentials below are local MinIO-style examples only, never production values.
MEDIA_HOST=127.0.0.1
MEDIA_PORT=3004
MEDIA_S3_PUBLIC_BUCKET=together-public-media
MEDIA_S3_PRIVATE_BUCKET=together-private-media
MEDIA_S3_ENDPOINT=http://127.0.0.1:9000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_FORCE_PATH_STYLE=true
MEDIA_S3_ACCESS_KEY_ID=together-local
MEDIA_S3_SECRET_ACCESS_KEY=together-local-only
MEDIA_S3_SSE=AES256
MEDIA_S3_KMS_KEY_ID=
MEDIA_UPLOAD_TTL_SECONDS=300
MEDIA_DOWNLOAD_TTL_SECONDS=600

# Safety shell. Executable service remains deny-all / persistence-disabled until auth and DB adapters are wired.
SAFETY_HOST=127.0.0.1
SAFETY_PORT=3005
SAFETY_BODY_LIMIT_BYTES=65536

# Finance shell. No mutable balance API; executable service remains deny-all / persistence-disabled until auth and DB adapters are wired.
FINANCE_HOST=127.0.0.1
FINANCE_PORT=3006
FINANCE_BODY_LIMIT_BYTES=65536
